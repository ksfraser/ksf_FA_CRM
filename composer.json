{
    "name": "ksfraser/ksf-fa-crm",
    "description": "FrontAccounting CRM Adapter",
    "type": "fa-module",
    "require": {
        "php": ">=7.4",
        "ksfraser/ksf-fa-common": "^1.0",
        "ksfraser/fa-classes": "*",
        "ksfraser/exceptions": "^1.2",
        "ksfraser/traits": "^1.2",
        "ksfraser/rbac": "*",
        "ksfraser/gedcom": "*",
        "ksfraser/html": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "ksfraser\\FrontAccounting\\CRM\\": "src/FrontAccounting/CRM/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../ksf_CRM",
            "canonical": false
        },
        {
            "type": "path",
            "url": "../ksf_RBAC",
            "canonical": false
        },
        {
            "type": "path",
            "url": "../Traits",
            "canonical": false
        },
        {
            "type": "path",
            "url": "../ksfraser/html",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/ksfraser/ksf_CRM_GEDCOM"
        }
    ],
    "config": {
        "platform": {
            "php": "7.4.33"
        },
        "sort-packages": true
    }
}
